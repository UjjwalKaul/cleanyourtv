<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_base"
    android:padding="48dp"
    android:gravity="center_vertical">

    <!-- Left Column: Pairing QR Code Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/pairing_instructions"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/qr_container"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:contentDescription="@string/pairing_title"
                android:scaleType="fitCenter" />
        </FrameLayout>

    </LinearLayout>

    <!-- Right Column: Status, URL & TV Controls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="32dp">

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="@string/status_waiting"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Connected Device Box with Sever Button -->
        <LinearLayout
            android:id="@+id/layoutConnectedDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/device_card_bg"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connected Phone"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeviceIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text=""
                    tools:text="192.168.1.50"
                    android:textColor="@color/status_success"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSever"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:background="@drawable/btn_danger_selector"
                android:text="@string/btn_disconnect"
                android:textColor="#FDA4AF"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/pairing_url_label"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="http://192.168.1.50:8080"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pairing_code_label"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/tvToken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="K9X2B7"
            android:textColor="@color/accent_cyan"
            android:textSize="34sp"
            android:letterSpacing="0.25"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRevoke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:background="@drawable/btn_primary_selector"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp"
                android:text="@string/btn_revoke"
                android:textColor="@color/text_primary"
                android:textSize="15sp">
                <requestFocus />
            </Button>

            <Button
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:focusable="true"
                android:background="@drawable/btn_secondary_selector"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp"
                android:text="@string/btn_close"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
